  "approach": {
    "description": "Configure OSPF on all routers with loopback interfaces",
    "commands": [
      {
        "node": "R1",
        "commands": [
          "vtysh -c 'configure terminal'",
          "vtysh -c 'interface eth1'",
          "vtysh -c 'ip address 192.168.1.1/24'",
          "vtysh -c 'ip ospf hello-interval 10'",
          "vtysh -c 'ip ospf dead-interval 40'",
          "vtysh -c 'interface lo'",
          "vtysh -c 'ip address 1.1.1.1/32'",
          "vtysh -c 'router ospf'",
          "vtysh -c 'network 192.168.1.0/24 area 0'",
          "vtysh -c 'network 1.1.1.1/32 area 0'",
          "vtysh -c 'end'"
        ]
