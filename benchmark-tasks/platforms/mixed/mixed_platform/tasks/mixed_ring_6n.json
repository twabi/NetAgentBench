{
  "task_id": "mixed_ring_6n",
  "description": "Ring 6-node: Mixed FRR, Nokia, Arista",
  "platform": "frr",
  "mixed_platforms": [
    "arista_eos",
    "frr",
    "nokia_srl"
  ],
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "frrouting/frr:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "ceos:latest",
        "platform": "arista_eos"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "frrouting/frr:latest",
        "platform": "frr"
      },
      {
        "name": "R5",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R6",
        "type": "router",
        "image": "ceos:latest",
        "platform": "arista_eos"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth2",
          "R4:eth1"
        ]
      },
      {
        "endpoints": [
          "R4:eth2",
          "R5:eth1"
        ]
      },
      {
        "endpoints": [
          "R5:eth2",
          "R6:eth1"
        ]
      },
      {
        "endpoints": [
          "R6:eth2",
          "R1:eth2"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "mixed_platform_connectivity",
        "type": "reachability",
        "description": "Connectivity verified between mixed platforms",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 3 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "3 packets transmitted"
          }
        }
      },
      {
        "id": "platform_interop",
        "type": "interface_up",
        "description": "Interfaces up across platform boundary",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ip link show",
          "parser": "text",
          "success_condition": {
            "contains_text": "state UP"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 45,
    "check_interval_seconds": 3
  },
  "optimal_solution": {
    "command_count": 24,
    "description": "Configure connectivity across 3 platforms"
  }
}