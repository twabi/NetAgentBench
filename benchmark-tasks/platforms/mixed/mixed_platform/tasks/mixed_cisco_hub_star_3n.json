{
  "task_id": "mixed_cisco_hub_star_3n",
  "description": "Star 3-node: Cisco hub, FRR spokes",
  "platform": "frr",
  "mixed_platforms": [
    "cisco_ios_xe",
    "frr"
  ],
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "frrouting/frr:latest",
        "platform": "frr"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:GigabitEthernet1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R1:GigabitEthernet2",
          "R3:GigabitEthernet1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "mixed_platform_connectivity",
        "type": "reachability",
        "description": "Connectivity verified between mixed platforms",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 3 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "3 packets transmitted"
          }
        }
      },
      {
        "id": "platform_interop",
        "type": "interface_up",
        "description": "Interfaces up across platform boundary",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ip link show",
          "parser": "text",
          "success_condition": {
            "contains_text": "state UP"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 45,
    "check_interval_seconds": 3
  },
  "optimal_solution": {
    "command_count": 12,
    "description": "Configure connectivity across 2 platforms"
  }
}