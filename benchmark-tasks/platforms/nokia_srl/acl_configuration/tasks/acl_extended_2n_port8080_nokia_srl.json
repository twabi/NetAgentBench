{
  "task_id": "acl_extended_2n_port8080_nokia_srl",
  "description": "Linear 2-node: Extended ACL for TCP/8080",
  "platform": "nokia_srl",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "acl_EXT_ACL_8080_exists",
        "type": "acl_configuration",
        "description": "ACL EXT_ACL_8080 is configured",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sr_cli -e 'info acl'",
          "parser": "text",
          "success_condition": {
            "contains_text": "EXT_ACL_8080"
          }
        }
      },
      {
        "id": "acl_EXT_ACL_8080_rule_0",
        "type": "acl_rule",
        "description": "ACL EXT_ACL_8080 contains rule: permit tcp from 10.0.0.0/24 to 192.168.0.0/24 port 8080",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show access-list'",
          "parser": "text",
          "success_condition": {
            "contains_text": "permit"
          }
        }
      },
      {
        "id": "acl_EXT_ACL_8080_applied",
        "type": "acl_interface_binding",
        "description": "ACL is applied to interface",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show running-config'",
          "parser": "text",
          "success_condition": {
            "contains_text": "access-group EXT_ACL_8080"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 7,
    "description": "Configure ACL EXT_ACL_8080 with permit tcp on 2 nodes"
  }
}