  "intent": {
    "properties": [
      {
        "id": "redist_static_to_ospf",
        "type": "route_redistribution",
        "description": "Routes from static are redistributed into ospf",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sr_cli -e 'info network-instance default protocols'",
          "parser": "text",
          "success_condition": {
            "contains_text": "export-policy"
          }
        }
      },
      {
        "id": "routes_in_ospf",
        "type": "route_exists",
        "description": "Redistributed routes appear in ospf table",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sr_cli -e 'show network-instance default route-table ipv4'",
          "parser": "text",
          "success_condition": {
            "contains_text": "ospf"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 60,
