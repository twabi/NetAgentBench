{
  "task_id": "redist_connected_to_bgp_linear_2n",
  "description": "Linear 2-node: Redistribute connected routes into BGP",
  "platform": "nokia_srl",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:ethernet-1/1",
          "R2:ethernet-1/1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "redist_connected_to_bgp",
        "type": "route_redistribution",
        "description": "Routes from connected are redistributed into bgp",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sr_cli -e 'info network-instance default protocols'",
          "parser": "text",
          "success_condition": {
            "contains_text": "export-policy"
          }
        }
      },
      {
        "id": "routes_in_bgp",
        "type": "route_exists",
        "description": "Redistributed routes appear in bgp table",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sr_cli -e 'show network-instance default route-table ipv4'",
          "parser": "text",
          "success_condition": {
            "contains_text": "bgp"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 60,
    "check_interval_seconds": 5
  },
  "optimal_solution": {
    "command_count": 14,
    "description": "Configure connected\u2192bgp redistribution on 2 nodes"
  }
}