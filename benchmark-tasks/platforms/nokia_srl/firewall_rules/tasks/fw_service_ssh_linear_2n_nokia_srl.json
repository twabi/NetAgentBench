{
  "task_id": "fw_service_ssh_linear_2n_nokia_srl",
  "description": "Linear 2-node: Allow SSH service through firewall",
  "platform": "nokia_srl",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "fw_ALLOW_SSH_exists",
        "type": "firewall_rule",
        "description": "Firewall rule ALLOW_SSH is configured with permit",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip firewall'",
          "parser": "text",
          "success_condition": {
            "contains_text": "ALLOW_SSH"
          }
        }
      },
      {
        "id": "reach_allowed_by_ALLOW_SSH",
        "type": "reachability",
        "description": "Traffic is allowed through firewall",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 2 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "2 packets transmitted"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 8,
    "description": "Configure firewall rule ALLOW_SSH on 2 nodes"
  }
}