{
  "task_id": "vlan_trunk_linear_4n",
  "description": "Configure Trunk with VLAN 10, 20, 30 allowed",
  "platform": "nokia_srl",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth3",
          "R4:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_10_exists",
        "type": "vlan_configuration",
        "description": "VLAN 10 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sr_cli -e 'info network-instance'",
          "parser": "text",
          "success_condition": {
            "contains_text": "mac-vrf"
          }
        }
      },
      {
        "id": "trunk_configured",
        "type": "trunk_configuration",
        "description": "Trunk ports configured correctly",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show interface trunk'",
          "parser": "text",
          "success_condition": {
            "contains_text": "trunk"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 16,
    "description": "Configure VLANs on 4 nodes"
  }
}