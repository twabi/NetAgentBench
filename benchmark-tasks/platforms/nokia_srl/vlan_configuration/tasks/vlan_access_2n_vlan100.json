{
  "task_id": "vlan_access_2n_vlan100",
  "description": "Configure Access ports for VLAN 100",
  "platform": "nokia_srl",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "ghcr.io/nokia/srlinux:latest",
        "platform": "nokia_srl"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_100_exists",
        "type": "vlan_configuration",
        "description": "VLAN 100 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show vlan brief'",
          "parser": "text",
          "success_condition": {
            "contains_text": "100"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 4,
    "description": "Configure VLANs on 2 nodes"
  }
}