{
  "task_id": "fw_dmz_2inner",
  "description": "DMZ with 2 internal nodes: Restrict outside to DMZ only",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "frrouting/frr:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "frrouting/frr:latest",
        "platform": "frr"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "frrouting/frr:latest",
        "platform": "frr"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "frrouting/frr:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R1:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R1:eth3",
          "R4:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "fw_DMZ_RULES_exists",
        "type": "firewall_rule",
        "description": "Firewall rule DMZ_RULES is configured with permit",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip firewall'",
          "parser": "text",
          "success_condition": {
            "contains_text": "DMZ_RULES"
          }
        }
      },
      {
        "id": "reach_allowed_by_DMZ_RULES",
        "type": "reachability",
        "description": "Traffic is allowed through firewall",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 2 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "2 packets transmitted"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 15,
    "description": "Configure firewall rule DMZ_RULES on 4 nodes"
  }
}