{
  "task_id": "bgp_ebgp_linear_2as_arista_eos",
  "description": "eBGP linear 2-AS topology - establish sessions",
  "platform": "arista_eos",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "ceos:latest",
        "platform": "arista_eos"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "ceos:latest",
        "platform": "arista_eos"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "bgp_session_R1_R2",
        "type": "bgp_configuration",
        "description": "BGP session between R1 and R2",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "Cli -c 'show ip bgp neighbors'",
          "parser": "text",
          "success_condition": {
            "contains_text": "Established"
          }
        }
      },
      {
        "id": "route_exchange_R1_to_R2",
        "type": "route_exists",
        "description": "Route from R1 to R2 exists via BGP",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "Cli -c 'show ip route bgp'",
          "parser": "text",
          "success_condition": {
            "contains_text": "B"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 60,
    "check_interval_seconds": 5
  },
  "optimal_solution": {
    "command_count": 16,
    "description": "Configure BGP on all 2 routers with appropriate AS and neighbors"
  }
}