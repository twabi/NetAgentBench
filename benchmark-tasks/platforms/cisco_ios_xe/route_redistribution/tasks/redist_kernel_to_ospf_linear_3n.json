{
  "task_id": "redist_kernel_to_ospf_linear_3n",
  "description": "Linear 3-node: Redistribute kernel routes into OSPF",
  "platform": "cisco_ios_xe",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "redist_kernel_to_ospf",
        "type": "route_redistribution",
        "description": "Routes from kernel are redistributed into ospf",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "cli -c 'show running-config | include redistribute'",
          "parser": "text",
          "success_condition": {
            "contains_text": "redistribute kernel"
          }
        }
      },
      {
        "id": "routes_in_ospf",
        "type": "route_exists",
        "description": "Redistributed routes appear in ospf table",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "cli -c 'show ip route ospf'",
          "parser": "text",
          "success_condition": {
            "contains_text": "K"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 60,
    "check_interval_seconds": 5
  },
  "optimal_solution": {
    "command_count": 20,
    "description": "Configure kernel\u2192ospf redistribution on 3 nodes"
  }
}