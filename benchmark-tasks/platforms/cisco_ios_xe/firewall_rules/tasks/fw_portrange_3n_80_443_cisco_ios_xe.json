{
  "task_id": "fw_portrange_3n_80_443_cisco_ios_xe",
  "description": "Linear 3-node: Allow port range 80-443",
  "platform": "cisco_ios_xe",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "fw_PORTS_80_443_exists",
