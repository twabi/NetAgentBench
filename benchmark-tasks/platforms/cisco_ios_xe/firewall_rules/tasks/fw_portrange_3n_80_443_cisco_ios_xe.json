        "description": "Firewall rule PORTS_80_443 is configured with permit",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip firewall'",
          "parser": "text",
          "success_condition": {
            "contains_text": "PORTS_80_443"
          }
        }
      },
      {
        "id": "reach_allowed_by_PORTS_80_443",
        "type": "reachability",
        "description": "Traffic is allowed through firewall",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 2 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "2 packets transmitted"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 10,
    "description": "Configure firewall rule PORTS_80_443 on 3 nodes"
  }
}