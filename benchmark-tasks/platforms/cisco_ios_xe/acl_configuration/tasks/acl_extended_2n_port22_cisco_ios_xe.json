        "image": "cisco-iosxe:latest",
        "platform": "cisco_ios_xe"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "acl_EXT_ACL_22_exists",
