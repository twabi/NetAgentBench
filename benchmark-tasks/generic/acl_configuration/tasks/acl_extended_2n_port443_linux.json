{
  "task_id": "acl_extended_2n_port443_linux",
  "description": "Linear 2-node: Extended ACL for TCP/443",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "acl_EXT_ACL_443_exists",
        "type": "acl_configuration",
        "description": "ACL EXT_ACL_443 is configured",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'iptables -L FORWARD -n | grep \"ACCEPT\"'",
          "parser": "text",
          "success_condition": {
            "contains_text": "ACCEPT"
          }
        }
      },
      {
        "id": "acl_EXT_ACL_443_rule_0",
        "type": "acl_rule",
        "description": "ACL EXT_ACL_443 contains rule: permit tcp from 10.0.0.0/24 to 192.168.0.0/24 port 443",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'iptables -L FORWARD -n | grep \"443\"'",
          "parser": "text",
          "success_condition": {
            "contains_text": "443"
          }
        }
      },
      {
        "id": "acl_EXT_ACL_443_applied",
        "type": "acl_interface_binding",
        "description": "ACL is applied to interface",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'iptables -L FORWARD -n'",
          "parser": "text",
          "success_condition": {
            "contains_text": "Chain FORWARD"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 7,
    "description": "Configure ACL EXT_ACL_443 with permit tcp on 2 nodes"
  }
