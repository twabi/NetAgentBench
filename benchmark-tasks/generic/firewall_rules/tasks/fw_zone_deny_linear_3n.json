{
  "task_id": "fw_zone_deny_linear_3n",
  "description": "Linear 3-node: Deny traffic from inside to outside zone",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "fw_ZONE_DENY_exists",
        "type": "firewall_rule",
        "description": "Firewall rule ZONE_DENY is configured with deny",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "iptables -L FORWARD -n",
          "parser": "text",
          "success_condition": {
            "contains_text": "ZONE_DENY"
          }
        }
      },
      {
        "id": "blocked_by_ZONE_DENY",
        "type": "firewall_block",
        "description": "Traffic is blocked by firewall rule",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "iptables -L FORWARD -n",
          "parser": "text",
          "success_condition": {
            "contains_text": "DROP"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 10,
    "description": "Configure firewall rule ZONE_DENY on 3 nodes"
  }
}