{
  "task_id": "fw_service_https_linear_4n",
  "description": "Linear 4-node: Allow HTTPS service through firewall",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth2",
          "R4:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "fw_ALLOW_HTTPS_exists",
        "type": "firewall_rule",
        "description": "Firewall rule ALLOW_HTTPS is configured with permit",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "iptables -L FORWARD -n",
          "parser": "text",
          "success_condition": {
            "contains_text": "ALLOW_HTTPS"
          }
        }
      },
      {
        "id": "reach_allowed_by_ALLOW_HTTPS",
        "type": "reachability",
        "description": "Traffic is allowed through firewall",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 2 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "2 packets transmitted, 2 packets received"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 12,
    "description": "Configure firewall rule ALLOW_HTTPS on 4 nodes"
  }
}