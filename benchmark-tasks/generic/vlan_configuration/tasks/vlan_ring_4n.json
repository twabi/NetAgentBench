{
  "task_id": "vlan_ring_4n",
  "description": "Ring 4-node: Configure VLAN 100 across ring with trunks",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth2",
          "R4:eth1"
        ]
      },
      {
        "endpoints": [
          "R4:eth2",
          "R1:eth2"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_100_exists",
        "type": "vlan_configuration",
        "description": "VLAN 100 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'ip -d link show | grep \"vlan\" | grep \"id 100\"'",
          "parser": "text",
          "success_condition": {
            "contains_text": "100"
          }
        }
      },
      {
        "id": "trunk_configured",
        "type": "trunk_configuration",
        "description": "Trunk ports configured correctly",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'bridge vlan show | grep 100'",
          "parser": "text",
          "success_condition": {
            "contains_text": "100"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 16,
    "description": "Configure VLANs on 4 nodes"
  }
}