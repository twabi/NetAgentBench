{
  "task_id": "vlan_svi_4n_vlan200",
  "description": "Linear 4-node: Create VLAN 200 SVI with IP",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth2",
          "R4:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_200_exists",
        "type": "vlan_configuration",
        "description": "VLAN 200 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'ip -d link show | grep \"vlan\" | grep \"id 200\"'",
          "parser": "text",
          "success_condition": {
            "contains_text": "200"
          }
        }
      },
      {
        "id": "svi_vlan200",
        "type": "svi_configuration",
        "description": "SVI for VLAN 200 has correct IP",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'ip addr show | grep 192.168.200.1'",
          "parser": "text",
          "success_condition": {
            "contains_text": "192.168.200.1"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 12,
    "description": "Configure VLANs on 4 nodes"
  }
}