{
  "task_id": "vlan_svi_2n_vlan10",
  "description": "Linear 2-node: Create VLAN 10 SVI with IP",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_10_exists",
        "type": "vlan_configuration",
        "description": "VLAN 10 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'ip -d link show | grep \"vlan\" | grep \"id 10\"'",
          "parser": "text",
          "success_condition": {
            "contains_text": "10"
          }
        }
      },
      {
        "id": "svi_vlan10",
        "type": "svi_configuration",
        "description": "SVI for VLAN 10 has correct IP",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'ip addr show | grep 192.168.10.1'",
          "parser": "text",
          "success_condition": {
            "contains_text": "192.168.10.1"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 6,
    "description": "Configure VLANs on 2 nodes"
  }
}