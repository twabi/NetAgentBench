{
  "task_id": "vlan_native_6n_vlan1",
  "description": "Linear 6-node: Configure native VLAN 1 on trunks",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R5",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R6",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth3",
          "R4:eth1"
        ]
      },
      {
        "endpoints": [
          "R4:eth4",
          "R5:eth1"
        ]
      },
      {
        "endpoints": [
          "R5:eth5",
          "R6:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_1_exists",
        "type": "vlan_configuration",
        "description": "VLAN 1 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'ip -d link show | grep \"vlan\" | grep \"id 1\"'",
          "parser": "text",
          "success_condition": {
            "contains_text": "1"
          }
        }
      },
      {
        "id": "trunk_configured",
        "type": "trunk_configuration",
        "description": "Trunk ports configured correctly",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'bridge vlan show | grep 1'",
          "parser": "text",
          "success_condition": {
            "contains_text": "1"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 24,
    "description": "Configure VLANs on 6 nodes"
  }
}