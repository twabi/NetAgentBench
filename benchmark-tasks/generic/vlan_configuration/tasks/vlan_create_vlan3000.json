{
  "task_id": "vlan_create_vlan3000",
  "description": "Configure VLAN 3000 on 2 switches",
  "platform": "linux",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "linux"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_3000_exists",
        "type": "vlan_configuration",
        "description": "VLAN 3000 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "sh -c 'ip -d link show | grep \"vlan\" | grep \"id 3000\"'",
          "parser": "text",
          "success_condition": {
            "contains_text": "3000"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 4,
    "description": "Configure VLANs on 2 nodes"
  }
}