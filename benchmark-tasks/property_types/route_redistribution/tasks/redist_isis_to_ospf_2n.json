{
  "task_id": "redist_isis_to_ospf_2n",
  "description": "Linear 2-node: Redistribute ISIS routes into OSPF",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "redist_isis_to_ospf",
        "type": "route_redistribution",
        "description": "Routes from isis are redistributed into ospf",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show running-config' | grep redistribute",
          "parser": "text",
          "success_condition": {
            "contains_text": "redistribute isis"
          }
        }
      },
      {
        "id": "routes_in_ospf",
        "type": "route_exists",
        "description": "Redistributed routes appear in ospf table",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip ospf' 2>/dev/null || vtysh -c 'show ip route ospf'",
          "parser": "text",
          "success_condition": {
            "contains_text": "I"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 60,
    "check_interval_seconds": 5
  },
  "optimal_solution": {
    "command_count": 14,
    "description": "Configure isis\u2192ospf redistribution on 2 nodes"
  }
}