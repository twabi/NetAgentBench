        "description": "Redistributed routes appear in bgp table",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip bgp' 2>/dev/null || vtysh -c 'show ip route bgp'",
