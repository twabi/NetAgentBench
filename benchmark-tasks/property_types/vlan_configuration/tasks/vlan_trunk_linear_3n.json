{
  "task_id": "vlan_trunk_linear_3n",
  "description": "Linear 3-node: Configure trunk ports allowing VLANs 10,20,30",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_10_exists",
        "type": "vlan_configuration",
        "description": "VLAN 10 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show vlan brief'",
          "parser": "text",
          "success_condition": {
            "contains_text": "10"
          }
        }
      },
      {
        "id": "trunk_configured",
        "type": "trunk_configuration",
        "description": "Trunk ports configured correctly",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show interface trunk'",
          "parser": "text",
          "success_condition": {
            "contains_text": "trunk"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 12,
    "description": "Configure VLANs on 3 nodes"
  }
}