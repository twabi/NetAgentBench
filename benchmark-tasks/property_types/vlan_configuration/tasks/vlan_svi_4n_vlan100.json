{
  "task_id": "vlan_svi_4n_vlan100",
  "description": "Linear 4-node: Create VLAN 100 SVI with IP",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth3",
          "R4:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "vlan_100_exists",
        "type": "vlan_configuration",
        "description": "VLAN 100 exists on all nodes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show vlan brief'",
          "parser": "text",
          "success_condition": {
            "contains_text": "100"
          }
        }
      },
      {
        "id": "svi_vlan100",
        "type": "svi_configuration",
        "description": "SVI for VLAN 100 has correct IP",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip interface vlan100'",
          "parser": "text",
          "success_condition": {
            "contains_text": "192.168.100.1"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 12,
    "description": "Configure VLANs on 4 nodes"
  }
}