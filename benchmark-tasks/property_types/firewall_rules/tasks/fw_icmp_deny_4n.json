{
  "task_id": "fw_icmp_deny_4n",
  "description": "Linear 4-node: Deny ICMP (ping)",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R3",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R4",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      },
      {
        "endpoints": [
          "R2:eth2",
          "R3:eth1"
        ]
      },
      {
        "endpoints": [
          "R3:eth3",
          "R4:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "fw_ICMP_DENY_exists",
        "type": "firewall_rule",
        "description": "Firewall rule ICMP_DENY is configured with deny",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip firewall'",
          "parser": "text",
          "success_condition": {
            "contains_text": "ICMP_DENY"
          }
        }
      },
      {
        "id": "blocked_by_ICMP_DENY",
        "type": "firewall_block",
        "description": "Traffic is blocked by firewall rule",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip firewall counters'",
          "parser": "text",
          "success_condition": {
            "contains_text": "deny"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 12,
    "description": "Configure firewall rule ICMP_DENY on 4 nodes"
  }
}