{
  "task_id": "acl_bidir_2n",
  "description": "Linear 2-node: Bidirectional traffic filtering",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": [
          "R1:eth1",
          "R2:eth1"
        ]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "acl_BIDIR_FILTER_exists",
        "type": "acl_configuration",
        "description": "ACL BIDIR_FILTER is configured with permit tcp",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show access-list'",
          "parser": "text",
          "success_condition": {
            "contains_text": "BIDIR_FILTER"
          }
        }
      },
      {
        "id": "acl_BIDIR_FILTER_permit",
        "type": "acl_rule",
        "description": "ACL contains permit rule for tcp",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show access-list'",
          "parser": "text",
          "success_condition": {
            "contains_text": "permit"
          }
        }
      },
      {
        "id": "acl_BIDIR_FILTER_applied",
        "type": "acl_interface_binding",
        "description": "ACL is applied to interface",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show running-config'",
          "parser": "text",
          "success_condition": {
            "contains_text": "access-group BIDIR_FILTER"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 10,
    "description": "Configure ACL BIDIR_FILTER with permit tcp on 2 nodes"
  }
}