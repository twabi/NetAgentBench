{
  "task_id": "bgp_basic",
  "description": "Basic BGP configuration with two routers and loopback interfaces",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": ["R1:eth1", "R2:eth1"]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "bgp_session_established",
        "type": "bgp_configuration",
        "description": "BGP session between R1 and R2 is established",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "echo '{\"peers\": {\"192.168.1.2\": {\"state\": \"Established\"}}}'",
          "parser": "json",
          "success_condition": {
            "json_path": "$.peers['192.168.1.2'].state",
            "expected_value": "Established"
          }
        }
      },
      {
        "id": "route_exists_r2",
        "type": "route_exists",
        "description": "Route to R2 loopback exists on R1",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "echo '2.2.2.2/32 via 192.168.1.2'",
          "parser": "regex",
          "success_condition": {
            "pattern": "2\\.2\\.2\\.2/32.*via.*192\\.168\\.1\\.2",
            "must_match": true
          }
        }
      },
      {
        "id": "loopback_reachability",
        "type": "reachability",
        "description": "R1 can reach R2 loopback",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 3 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "3 packets transmitted, 3 packets received"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 45,
    "check_interval_seconds": 3
  },
  "optimal_solution": {
    "command_count": 12,
    "description": "Configure IP addresses, loopbacks, and BGP session between routers"
  }
}
