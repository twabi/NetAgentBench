{
  "task_id": "basic_reachability",
  "description": "Basic two-node reachability test - configure IP addresses and test ping",
  "platform": "frr",
  "topology": {
    "nodes": [
      {
        "name": "R1",
        "type": "router",
        "image": "alpine:latest",
        "platform": "frr"
      },
      {
        "name": "R2",
        "type": "router", 
        "image": "alpine:latest",
        "platform": "frr"
      }
    ],
    "links": [
      {
        "endpoints": ["R1:eth1", "R2:eth1"]
      }
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "reachability_r1_to_r2",
        "type": "reachability",
        "description": "R1 can reach R2 via ping",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 3 192.168.1.2",
          "parser": "text",
          "success_condition": {
            "contains_text": "3 packets transmitted, 3 packets received"
          }
        }
      }
    ]
  },
  "convergence": {
    "timeout_seconds": 30,
    "check_interval_seconds": 2
  },
  "optimal_solution": {
    "command_count": 4,
    "description": "Configure IP addresses on both router interfaces"
  }
}
