{
  "task_id": "guide_ospf_multiarea",
  "description": "Deploy multi-area OSPF on four FRR routers. R1 and R2 form Area 0 (backbone). R2 connects to R3 in Area 1. R3 connects to R4 in Area 1. Configure IP addressing, enable OSPF on all routers with correct area assignments, and verify inter-area reachability.\n\nIP Addressing Plan:\n- R1: eth1=10.0.12.1/30, lo=10.0.0.1/32\n- R2: eth1=10.0.12.2/30, eth2=10.1.23.2/30, lo=10.0.0.2/32\n- R3: eth1=10.1.23.3/30, eth2=10.1.34.3/30, lo=10.0.0.3/32\n- R4: eth1=10.1.34.4/30, lo=10.0.0.4/32",
  "platform": "frr",
  "evaluation_mode": "multi_turn",
  "topology": {
    "nodes": [
      {"name": "R1", "type": "router", "image": "frrouting/frr:latest", "platform": "frr"},
      {"name": "R2", "type": "router", "image": "frrouting/frr:latest", "platform": "frr"},
      {"name": "R3", "type": "router", "image": "frrouting/frr:latest", "platform": "frr"},
      {"name": "R4", "type": "router", "image": "frrouting/frr:latest", "platform": "frr"}
    ],
    "links": [
      {"endpoints": ["R1:eth1", "R2:eth1"]},
      {"endpoints": ["R2:eth2", "R3:eth1"]},
      {"endpoints": ["R3:eth2", "R4:eth1"]}
    ],
    "interfaces": []
  },
  "intent": {
    "properties": [
      {
        "id": "area0_adjacency",
        "type": "ospf_configuration",
        "description": "OSPF Area 0 adjacency is Full between R1 and R2",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip ospf neighbor'",
          "parser": "text",
          "success_condition": {"contains_text": "Full/"}
        }
      },
      {
        "id": "area1_adjacency",
        "type": "ospf_configuration",
        "description": "OSPF adjacency is Full between R3 and R4 in Area 1",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R3",
          "command": "vtysh -c 'show ip ospf neighbor'",
          "parser": "text",
          "success_condition": {"contains_text": "Full/"}
        }
      },
      {
        "id": "inter_area_routes",
        "type": "ospf_configuration",
        "description": "R1 learns inter-area OSPF routes from Area 1",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip route ospf'",
          "parser": "text",
          "success_condition": {"contains_text": "O IA", "case_insensitive": true}
        }
      },
      {
        "id": "loopback_reachability",
        "type": "reachability",
        "description": "R1 can reach R4 loopback 10.0.0.4 via OSPF",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 3 -W 2 10.0.0.4",
          "parser": "text",
          "success_condition": {"contains_text": "3 packets transmitted, 3 packets received"}
        }
      },
      {
        "id": "ospf_routes_on_r4",
        "type": "route_exists",
        "description": "R4 has OSPF routes in its routing table",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R4",
          "command": "vtysh -c 'show ip route ospf'",
          "parser": "text",
          "success_condition": {"contains_text": "O>"}
        }
      }
    ]
  },
  "convergence": {"timeout_seconds": 60, "check_interval_seconds": 3},
  "optimal_solution": {
    "command_count": 40,
    "description": "Configure interfaces, enable OSPF with area 0 on R1-R2 link and area 1 on R2-R3 and R3-R4 links, verify adjacencies and reachability"
  },
  "research_context": {
    "complexity": "intermediate",
    "expected_turns": "25-40",
    "expected_time_minutes": 25,
    "experiment": "property_guidance"
  }
