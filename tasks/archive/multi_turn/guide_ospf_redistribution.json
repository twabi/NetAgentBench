        }
      },
      {
        "id": "redistributed_external_route",
        "type": "ospf_configuration",
        "description": "R1 sees the redistributed 192.168.10.0/24 as an OSPF external route",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip route ospf'",
          "parser": "text",
          "success_condition": {"contains_text": "192.168.10"}
