          "success_condition": {
            "match_count": 2,
            "pattern": "Full"
          }
        }
      },
      {
        "id": "reachability_r1_to_r8",
        "type": "reachability",
        "description": "R1 can reach R8 (halfway around ring via OSPF)",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "ping -c 3 -W 2 10.0.0.8",
          "parser": "text",
          "success_condition": {
            "contains_text": "3 packets transmitted, 3 packets received"
          }
        }
      },
      {
        "id": "reachability_r1_to_r15",
