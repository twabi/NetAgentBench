        "id": "ospf_neighbor_r1_r2",
        "type": "ospf_configuration",
        "description": "R1 has OSPF neighbor relationship with R2",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip ospf neighbor'",
          "parser": "text",
          "success_condition": {
            "contains_text": "Full"
          }
        }
      },
      {
        "id": "ospf_neighbor_r8_both",
        "type": "ospf_configuration",
        "description": "R8 (middle router) has OSPF neighbors on both sides",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R8",
          "command": "vtysh -c 'show ip ospf neighbor'",
