  "intent": {
    "properties": [
      {
        "id": "backbone_adjacencies_full",
        "type": "ospf_configuration",
        "description": "R1 has Full adjacencies with both ABRs (R2 and R3) in Area 0",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip ospf neighbor'",
          "parser": "regex",
          "success_condition": {
            "pattern": "\\A(?=.*^10\\.0\\.0\\.2\\s+\\d+\\s+Full/)(?=.*^10\\.0\\.0\\.3\\s+\\d+\\s+Full/)",
            "must_match": true
          }
        }
      },
      {
        "id": "area1_adjacency_full",
        "type": "ospf_configuration",
        "description": "R4 has a Full adjacency with its ABR R2",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R4",
          "command": "vtysh -c 'show ip ospf neighbor'",
          "parser": "regex",
          "success_condition": {
            "pattern": "^10\\.0\\.0\\.2\\s+\\d+\\s+Full/",
            "must_match": true
          }
        }
      },
      {
        "id": "area2_adjacency_full",
        "type": "ospf_configuration",
        "description": "R5 has a Full adjacency with its ABR R3",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R5",
          "command": "vtysh -c 'show ip ospf neighbor'",
          "parser": "regex",
          "success_condition": {
            "pattern": "^10\\.0\\.0\\.3\\s+\\d+\\s+Full/",
            "must_match": true
          }
        }
      },
      {
        "id": "interarea_routes_in_backbone",
        "type": "ospf_configuration",
        "description": "R1 holds inter-area routes for both Area 1 and Area 2 prefixes",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip ospf route'",
          "parser": "regex",
          "success_condition": {
            "pattern": "\\A(?=.*^N IA\\s+10\\.1\\.)(?=.*^N IA\\s+10\\.2\\.)",
            "must_match": true
          }
        }
      },
      {
        "id": "area1_to_area2_reachability",
        "type": "reachability",
        "description": "R4's loopback (Area 1) reaches R5's loopback (Area 2)",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R4",
          "command": "ping -c 3 -W 2 -I 10.1.255.4 10.2.255.5",
          "parser": "regex",
          "success_condition": {
            "pattern": "3 packets transmitted, 3 (?:packets )?received",
            "must_match": true
          }
        }
      },
      {
        "id": "area1_summarized",
        "type": "ospf_configuration",
        "description": "R2 advertises Area 1 into the backbone as the single summary 10.1.0.0/16",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip ospf route'",
          "parser": "regex",
          "success_condition": {
            "pattern": "\\A(?=.*^N IA\\s+10\\.1\\.0\\.0/16)(?!.*^N IA\\s+10\\.1\\.24\\.0/30)",
            "must_match": true
          }
        }
      },
      {
        "id": "area2_summarized",
        "type": "ospf_configuration",
        "description": "R3 advertises Area 2 into the backbone as the single summary 10.2.0.0/16",
        "evaluation": {
          "method": "exec_and_parse",
          "target_node": "R1",
          "command": "vtysh -c 'show ip ospf route'",
          "parser": "regex",
          "success_condition": {
            "pattern": "\\A(?=.*^N IA\\s+10\\.2\\.0\\.0/16)(?!.*^N IA\\s+10\\.2\\.35\\.0/30)",
            "must_match": true
          }
        }
      }
    ]
